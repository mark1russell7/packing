{
  "$schema": "./node_modules/@mark1russell7/ste-lint/ste.config.schema.json",
  "include": [
    "README.md",
    "AI-REVIEW.md",
    "CODEX-REVIEW.md",
    "CLAUDE.md",
    "RELEASING.md",
    "CI.md",
    "packages/*/README.md",
    "packages/site/content/**/*.md",
    "packages/*/src/**/*.{ts,tsx}",
    "packages/*/bench/**/*.ts",
    "packages/*/*.config.{ts,mts}",
    "docs/BENCH.md"
  ],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/*.d.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ],
  "technicalNouns": ["nesting"],
  "technicalVerbs": [],
  "properNouns": [
    "ASD",
    "ASD-STE100",
    "Claude",
    "GitHub",
    "pnpm",
    "Simplified Technical English",
    "TSDoc",
    "TypeScript",
    "npm",
    "OIDC",
    "SemVer",
    "Mark"
  ]
}
