{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/packing",
  "version": "0.1.7",
  "description": "Rectangle packing: shelf, guillotine and skyline strategies, push cascades and measures of a layout.",
  "keywords": [
    "rectangle-packing",
    "bin-packing",
    "strip-packing",
    "layout",
    "guillotine",
    "skyline",
    "typescript"
  ],
  "homepage": "https://mark1russell7.github.io/packing/",
  "bugs": {
    "url": "https://github.com/mark1russell7/packing/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/packing.git",
    "directory": "packages/packing"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/main.tsx",
    "!src/page.css"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "bench": "node bench/main.ts",
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^1.0.2",
    "@mark1russell7/layout-contract": "github:mark1russell7/layout-contract#710ec519027dbc122d111cc5e76a1c18877f4237&path:packages/layout-contract",
    "@types/node": "^26.6.4",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
