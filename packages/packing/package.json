{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/packing",
  "version": "0.5.0",
  "description": "Rectangle packing: shelf, guillotine and skyline strategies, push cascades and measures of a layout.",
  "keywords": [
    "rectangle-packing",
    "bin-packing",
    "strip-packing",
    "layout",
    "guillotine",
    "skyline",
    "typescript"
  ],
  "homepage": "https://mark1russell7.github.io/packing/",
  "bugs": {
    "url": "https://github.com/mark1russell7/packing/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/packing.git",
    "directory": "packages/packing"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./default": "./src/entry/default.ts",
    "./guillotine": "./src/entry/guillotine.ts",
    "./hole-degree": "./src/entry/hole-degree.ts",
    "./maxrects": "./src/entry/maxrects.ts",
    "./push": "./src/entry/push.ts",
    "./rows": "./src/entry/rows.ts",
    "./shelf": "./src/entry/shelf.ts",
    "./skyline": "./src/entry/skyline.ts",
    "./bench/entries": "./bench/entries.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/main.tsx",
    "!src/page.css"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./default": {
        "types": "./build/entry/default.d.ts",
        "default": "./build/entry/default.js"
      },
      "./guillotine": {
        "types": "./build/entry/guillotine.d.ts",
        "default": "./build/entry/guillotine.js"
      },
      "./hole-degree": {
        "types": "./build/entry/hole-degree.d.ts",
        "default": "./build/entry/hole-degree.js"
      },
      "./maxrects": {
        "types": "./build/entry/maxrects.d.ts",
        "default": "./build/entry/maxrects.js"
      },
      "./push": {
        "types": "./build/entry/push.d.ts",
        "default": "./build/entry/push.js"
      },
      "./rows": {
        "types": "./build/entry/rows.d.ts",
        "default": "./build/entry/rows.js"
      },
      "./shelf": {
        "types": "./build/entry/shelf.d.ts",
        "default": "./build/entry/shelf.js"
      },
      "./skyline": {
        "types": "./build/entry/skyline.d.ts",
        "default": "./build/entry/skyline.js"
      },
      "./package.json": "./package.json"
    }
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@mark1russell7/layout-contract": "^0.3.1"
  },
  "scripts": {
    "bench": "node bench/main.ts",
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^1.0.2",
    "@types/node": "^26.6.4",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
