{
  "$schema": "https://json.schemastore.org/package",
  "name": "packing-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "package": "template package",
    "template": "template repo",
    "test": "pnpm -r run test && pnpm run test:ai-review",
    "test:ai-review": "node --test \"scripts/ai-review/*.test.mjs\"",
    "typecheck": "pnpm -r run typecheck",
    "lint:ste": "ste-lint",
    "check:boundaries": "depcruise --config .dependency-cruiser.mjs packages",
    "check:api": "api-report check",
    "check:conventions": "conventions check"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@mark1russell7/api-report": "^0.2.0",
    "@mark1russell7/boundaries": "^0.2.0",
    "@mark1russell7/conventions": "^0.22.0",
    "@mark1russell7/cue": "^1.0.2",
    "@mark1russell7/ste-lint": "^0.1.1",
    "@mark1russell7/template-cli": "^0.1.0",
    "@swc/core": "^1.15.0",
    "dependency-cruiser": "^18.7.0",
    "publint": "^0.3.25",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "conventions": {
    "rules": {
      "typed-scripts": {
        "ignore": [
          "scripts/ai-review/**",
          ".dependency-cruiser.mjs"
        ],
        "reason": "These are template files, and the template sync brings their .ts forms."
      }
    }
  }
}
